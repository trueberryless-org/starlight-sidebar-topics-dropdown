{
  "name": "starlight-sidebar-topics-dropdown-monorepo",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Starlight component to display the Starlight Sidebar Topics plugin topic list as a dropdown menu.",
  "author": "trueberryless <trueberryless@gmail.com> (https://felixs.dev)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter starlight-sidebar-topics-dropdown-docs build",
    "check": "pnpm --filter starlight-sidebar-topics-dropdown-docs astro sync && astro check --noSync",
    "dev": "pnpm --filter starlight-sidebar-topics-dropdown-docs dev",
    "format": "prettier . --write --cache --ignore-unknown",
    "version": "pnpm changeset version && pnpm i --no-frozen-lockfile"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "astro": "^7.3.5",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://starlight-sidebar-topics-dropdown.netlify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trueberryless-org/starlight-sidebar-topics-dropdown.git"
  },
  "bugs": "https://github.com/trueberryless-org/starlight-sidebar-topics-dropdown/issues"
}
